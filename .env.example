# Copy to .env; npm run deploy, npm run connect-google and npm run dev read it.

# Your WorkOS AuthKit domain (WorkOS dashboard > Authentication > AuthKit domain).
# The same environment as the Cronometer server works.
AUTHKIT_DOMAIN=https://your-domain.authkit.app

# Comma-separated WorkOS user ids allowed to use the server (dashboard > Users).
# Empty locks everyone out.
ALLOWED_SUBJECTS=user_01...

# The only Google account the server will connect to and act on.
ALLOWED_GOOGLE_EMAIL=matt@mattdavidson.kiwi

# Optional: AWS region and stack name.
# AWS_REGION=us-east-1
# STACK_NAME=gmail-spam-mcp

# Optional: most copies of the function that may run at once (default 25).
# Set 0 on a new AWS account whose Lambda concurrency quota is only 10.
# RESERVED_CONCURRENCY=0
